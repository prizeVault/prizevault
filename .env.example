# PrizeVault app configuration. Copy to .env and load it with
#   node --env-file=.env app/src/cli.ts <command>
# (Node 22 reads --env-file natively; nothing is loaded automatically.)
# scripts/deploy-testnet.sh writes a filled-in app/.env.testnet.

# Soroban RPC endpoint. All commands need it; read-only commands only simulate.
STELLAR_RPC_URL=https://soroban-testnet.stellar.org

# Network passphrase matching the RPC endpoint.
STELLAR_NETWORK_PASSPHRASE=Test SDF Network ; September 2015

# Deployed PrizeVault contract id (C...). Printed by scripts/deploy-testnet.sh.
PRIZEVAULT_CONTRACT_ID=

# Secret key (S...) of whoever signs the command: organizer for create/open/results/cancel,
# sponsor for fund, player for register/claim, referee for confirm/reject.
# Not needed for status, proof-of-funds or results --dry-run. Never commit a real key.
STELLAR_SECRET_KEY=

# SEP-41 token contract used by `create` when --token is not passed
# (a Stellar Asset Contract address for USDC, or the TUSD test asset the deploy script wraps).
TOKEN_CONTRACT_ID=

# Display settings for amounts. USDC on Stellar has 7 decimals.
TOKEN_DECIMALS=7
TOKEN_SYMBOL=USDC
