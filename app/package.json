{
  "name": "prizevault",
  "version": "0.1.0",
  "private": true,
  "description": "CLI and proof-of-funds tooling for the PrizeVault Soroban contract",
  "license": "MIT",
  "type": "module",
  "bin": {
    "prizevault": "./dist/cli.js"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
